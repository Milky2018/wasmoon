*.mbti whitespace=-blank-at-eof
modules/wasmoon/wasi_component/wit/** whitespace=-blank-at-eol
# Preserve the pinned upstream license byte-for-byte.
wasi-tests/wasmtime/upstream/LICENSE whitespace=-blank-at-eof

# Unified diff context lines intentionally contain a single space.
wasi-tests/wasmtime/explicit-rights.patch whitespace=-blank-at-eol

# Preserve the pinned Wasmtime misc corpus, including original whitespace.
wasm-tests/wasmtime/upstream/** whitespace=-blank-at-eol,-blank-at-eof

# Pinned conformance inputs must retain exact upstream bytes on every host.
# In particular, core.autocrlf must not rewrite snapshot hashes or patch context.
component-spec/upstream/** -text
wasi-tests/wasmtime/** -text
wasm-tests/wasmtime/upstream/** -text
spec/** -text
