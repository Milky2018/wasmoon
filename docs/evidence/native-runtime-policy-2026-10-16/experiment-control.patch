+
+// Experiment only: same-binary native control for the MoonBit retry policy.
+int32_t gc_native_policy_control(void *raw, int32_t wide) {
+    gc_allocation_request_t *request = raw;
+    int32_t collections = wide ? 1 : 3;
+    for (int32_t i = 0; i < collections; ++i) {
+        if (wasmoon_gc_allocation_collect(request) < 0) return -10;
+        int32_t reference = wasmoon_gc_allocation_attempt(request);
+        if (reference > 0) return reference;
+    }
+    int32_t denial = wasmoon_gc_allocation_denial(request);
+    return denial == 1 ? -25 : denial == 2 ? -26 : -9;
+}
