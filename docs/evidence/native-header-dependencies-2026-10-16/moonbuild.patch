+
+/// A shared ABI header must invalidate every including C object, independently
+/// of MoonBit imports, profile and the directory containing the transitive leaf.
+#[test]
+fn test_native_transitive_shared_header_changes_without_clean() {
+    for profile in ["--debug", "--release"] {
+        let dir = TestDir::new_empty();
+        std::fs::write(dir.join("moon.mod"), "name = \"test/shared_headers\"\n").unwrap();
+        for package in ["producer", "consumer"] {
+            std::fs::create_dir_all(dir.join(package)).unwrap();
+            std::fs::write(
+                dir.join(format!("{package}/moon.pkg")),
+                format!("options(\"native-stub\": [\"{package}.c\"])\n"),
+            )
+            .unwrap();
+            std::fs::write(
+                dir.join(format!("{package}/size.mbt")),
+                format!("pub extern \"c\" fn size() -> Int = \"{package}_size\"\n"),
+            )
+            .unwrap();
+            std::fs::write(dir.join(format!("{package}/{package}.c")),
+                format!("#include \"../producer/api.h\"\nint {package}_size(void) {{ return sizeof(struct payload) + MARKER; }}\n")).unwrap();
+        }
+        std::fs::create_dir_all(dir.join("main")).unwrap();
+        std::fs::write(dir.join("main/moon.pkg"),
+            "import { \"test/shared_headers/producer\", \"test/shared_headers/consumer\" }\npkgtype(kind: \"executable\")\n").unwrap();
+        std::fs::write(
+            dir.join("main/main.mbt"),
+            "fn main { println(@producer.size()); println(@consumer.size()) }\n",
+        )
+        .unwrap();
+        std::fs::write(dir.join("producer/api.h"), "#include \"shared.h\"\n").unwrap();
+        let args = ["run", "main", "--target", "native", profile];
+        std::fs::write(
+            dir.join("producer/shared.h"),
+            "#define MARKER 0\nstruct payload { long long first; };\n",
+        )
+        .unwrap();
+        crate::moon_cmd(&dir)
+            .args(args)
+            .assert()
+            .success()
+            .stdout_eq("8\n8\n");
+        std::fs::write(
+            dir.join("producer/shared.h"),
+            "#define MARKER 0\nstruct payload { long long first, second; };\n",
+        )
+        .unwrap();
+        crate::moon_cmd(&dir)
+            .args(args)
+            .assert()
+            .success()
+            .stdout_eq("16\n16\n");
+        // Same-length edits must also invalidate the action.
+        std::fs::write(
+            dir.join("producer/shared.h"),
+            "#define MARKER 1\nstruct payload { long long first, second; };\n",
+        )
+        .unwrap();
+        crate::moon_cmd(&dir)
+            .args(args)
+            .assert()
+            .success()
+            .stdout_eq("17\n17\n");
+        // A new include edge replaces the old discovered dependency closure.
+        std::fs::write(
+            dir.join("shared abi.inc"),
+            "#define MARKER 2\nstruct payload { long long first, second; };\n",
+        )
+        .unwrap();
+        std::fs::write(
+            dir.join("producer/api.h"),
+            "#include \"../shared abi.inc\"\n",
+        )
+        .unwrap();
+        crate::moon_cmd(&dir)
+            .args(args)
+            .assert()
+            .success()
+            .stdout_eq("18\n18\n");
+        std::fs::write(
+            dir.join("shared abi.inc"),
+            "#define MARKER 3\nstruct payload { long long first, second; };\n",
+        )
+        .unwrap();
+        crate::moon_cmd(&dir)
+            .args(args)
+            .assert()
+            .success()
+            .stdout_eq("19\n19\n");
+        std::fs::remove_file(dir.join("shared abi.inc")).unwrap();
+        crate::moon_cmd(&dir).args(args).assert().failure();
+    }
+}
