+MOONBIT_FFI_EXPORT int32_t wasmoon_exception_performance_reserve(void) {
+    const char *reserve = getenv("WASMOON_EXCEPTION_RESERVE");
+    return reserve ? atoi(reserve) : 0;
+}
+MOONBIT_FFI_EXPORT void wasmoon_exception_storage_reserve_control(exception_storage_t *storage, int32_t count) {
+    if (count <= storage->capacity) return;
+    void *entries = realloc(storage->entries, (size_t)count * sizeof(*storage->entries));
+    if (!entries) abort();
+    storage->entries = entries;
+    storage->capacity = count;
+}
