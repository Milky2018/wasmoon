{
  "schema_version": 1,
  "oracle": {
    "name": "wasmtime",
    "version": "45.0.0",
    "installer": "scripts/install_wasmtime_oracle.py"
  },
  "source_checks": {
    "stable_interface": "modules/wasmoon/component/pkg.generated.mbti",
    "validator": "modules/wasm_component/validator/validate.mbt",
    "validator_interface": "modules/wasm_component/validator/pkg.generated.mbti",
    "runtime_interface": "modules/wasmoon/component/runtime_impl/pkg.generated.mbti",
    "interface_scan_root": "modules/wasmoon",
    "implementation_owner_roots": [
      "Milky2018/wasmoon/component/runtime_impl",
      "Milky2018/wasmoon/component_engine",
      "Milky2018/wasmoon/component_host",
      "Milky2018/wasmoon/component_native"
    ],
    "implementation_interface_allowlist": [
      "modules/wasmoon/component_native/pkg.generated.mbti",
      "modules/wasmoon/wasi_component/pkg.generated.mbti"
    ],
    "forbidden_termination_roots": [
      "modules/wasm_component",
      "modules/wasmoon/component/runtime_impl",
      "modules/wasm_component/validator",
      "modules/wasm_component/wit"
    ],
    "forbidden_termination_patterns": [
      "abort(",
      "try!"
    ],
    "termination_allowlist": [],
    "unsafe_conversion_allowlist": [
      {
        "path": "modules/wasm_component/binary.mbt",
        "max_occurrences": 4,
        "rationale": "UTF-8 decoder validates byte and scalar ranges before conversion."
      },
      {
        "path": "modules/wasmoon/component/runtime_impl/build_strings.mbt",
        "max_occurrences": 4,
        "rationale": "Canonical string decoder validates byte and scalar ranges before conversion."
      },
      {
        "path": "modules/wasmoon/component/runtime_impl/core_type_reader.mbt",
        "max_occurrences": 4,
        "rationale": "Core type-name decoder validates byte and scalar ranges before conversion."
      },
      {
        "path": "modules/wasmoon/component/runtime_impl/memory_flat.mbt",
        "max_occurrences": 4,
        "rationale": "Canonical memory string paths range-check code points before conversion."
      },
      {
        "path": "modules/wasm_component/validator/core_type.mbt",
        "max_occurrences": 1,
        "rationale": "Name normalization adds a bounded ASCII offset."
      },
      {
        "path": "modules/wasm_component/validator/prelude.mbt",
        "max_occurrences": 1,
        "rationale": "Validated name bytes are converted after range checks."
      },
      {
        "path": "modules/wasm_component/wit/component_decoding.mbt",
        "max_occurrences": 2,
        "rationale": "Decoded component name bytes are already validated as byte values."
      },
      {
        "path": "modules/wasm_component/wit/component_encoding.mbt",
        "max_occurrences": 1,
        "rationale": "Encoded bytes are read from a valid generated UTF-8 sequence."
      },
      {
        "path": "modules/wasm_component/wit/parser.mbt",
        "max_occurrences": 3,
        "rationale": "Lexer branches validate ASCII and escaped scalar ranges first."
      },
      {
        "path": "modules/wasm_component/wit/resolve.mbt",
        "max_occurrences": 1,
        "rationale": "Resolution copies an existing valid code unit."
      },
      {
        "path": "modules/wasm_component/text/component_wat.mbt",
        "max_occurrences": 6,
        "rationale": "The lexer converts bounded UTF-16 code units already stored in a MoonBit String, while byte escapes are restricted to 0x00 through 0xff."
      }
    ]
  },
  "evidence": [
    {
      "name": "fuzz",
      "command": "python3 scripts/component_fuzz.py",
      "report": "target/component-hardening/fuzz/report.json"
    },
    {
      "name": "wasmtime-differential",
      "command": "python3 scripts/component_differential.py --wasmtime target/component-hardening/wasmtime-oracle/wasmtime",
      "report": "target/component-hardening/differential/report.json"
    },
    {
      "name": "logical-resource-lifecycle",
      "command": "moon test modules/wasmoon/component/runtime_impl/runtime_cleanup_wbtest.mbt",
      "report": "target/component-hardening/lifecycle.log"
    },
    {
      "name": "native-runtime-tests",
      "command": "moon test --target native",
      "report": "target/component-hardening/native-tests.log"
    },
    {
      "name": "large-component-stress",
      "command": "python3 scripts/component_stress.py",
      "report": "target/component-hardening/stress/report.json"
    }
  ],
  "ci": {
    "platform_workflow": ".github/workflows/check.yml"
  }
}
