  "measurement_script": "import hashlib,json,os,platform,statistics,subprocess,tempfile,time\nfrom pathlib import Path\nroot=Path('/Users/zhengyu/Documents/projects/wasmoon')\nbinaries={'before':Path('/tmp/wasmoon-perf-before-539'),'after':Path('/tmp/wasmoon-perf-after-539')}\nkeys=['optimize_us','lower_us','target_lower_us','regalloc_us','frame_plan_us','emit_us']\nreport={'host':platform.platform(),'baseline_revision':'471b24cc44fe95728d0f84c7a94b6dfc516b6d49','method':'Seven alternating-order pairs after one warmup pair per workload. Every process has an empty unique JIT cache. No concurrent compilation. Times include optional metrics instrumentation. Guest stdout reports timing and is not an equality oracle.','binaries':{k:hashlib.sha256(v.read_bytes()).hexdigest() for k,v in binaries.items()},'workloads':[]}\nfor workload in ['aead_aegis128l','aead_aegis256']:\n path=root/'examples/algorithms'/f'{workload}.wasm'\n records=[];expected=None\n for pair in range(-1,7):\n  for variant in (['before','after'] if pair%2==0 else ['after','before']):\n   with tempfile.TemporaryDirectory(prefix='iss539-') as d:\n    cache=Path(d)/'cache';metrics=Path(d)/'metrics.json'\n    env=dict(os.environ,WASMOON_JIT_CACHE_DIR=str(cache),WASMOON_PERF_METRICS='1',WASMOON_PERF_METRICS_FILE=str(metrics))\n    start=time.perf_counter()\n    result=subprocess.run([str(binaries[variant]),'run',str(path)],env=env,capture_output=True,text=True,timeout=120,check=True)\n    elapsed=time.perf_counter()-start\n    data=json.loads(metrics.read_text())\n    invariants=[{k:f[k] for k in ['func_idx','code_size','spill_slots','spills','reloads','reg_moves','spill_to_spill']} for f in data['functions']]\n    if expected is None:expected=invariants\n    assert invariants==expected,(workload,variant,'allocation/code-size drift')\n    assert data['functions'] and int(data['module_compile_us'])>0\n    if pair>=0:\n     records.append({'pair':pair,'variant':variant,'module_compile_us':int(data['module_compile_us']),'wall_ms':elapsed*1000,'phases':{k:sum(int(f[k]) for f in data['functions']) for k in keys},'stdout':result.stdout.strip()})\n summaries={v:{'module_compile_us':statistics.median(r['module_compile_us'] for r in records if r['variant']==v),'phases':{k:statistics.median(r['phases'][k] for r in records if r['variant']==v) for k in keys}} for v in binaries}\n ratios=[]\n for i in range(7):\n  pair={r['variant']:r['module_compile_us'] for r in records if r['pair']==i};ratios.append(pair['after']/pair['before']-1)\n entry={'name':workload,'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'summaries':summaries,'paired_change_percent':statistics.median(ratios)*100,'paired_changes_percent':[x*100 for x in ratios],'invariants':expected,'records':records}\n report['workloads'].append(entry)\n print(workload,summaries,'paired change',entry['paired_change_percent'],flush=True)\nreport['measurement_script']=Path(__file__).read_text()\n(root/'docs/perf/allocation-snapshots-2026-09-16.json').write_text(json.dumps(report,indent=2)+'\\n')\n"
