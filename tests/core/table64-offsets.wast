(module
  (table i64 1 funcref)
  (func (export "get") (param i64) (result i32)
    local.get 0 table.get 0 ref.is_null)
  (func (export "set") (param i64)
    local.get 0 ref.null func table.set 0)
  (func (export "fill") (param i64 i64)
    local.get 0 ref.null func local.get 1 table.fill 0)
  (func (export "copy") (param i64 i64 i64)
    local.get 0 local.get 1 local.get 2 table.copy 0 0))
(assert_trap (invoke "get" (i64.const 4294967296)) "out of bounds table access")
(assert_trap (invoke "set" (i64.const 4294967296)) "out of bounds table access")
(assert_trap (invoke "fill" (i64.const 4294967296) (i64.const 0)) "out of bounds table access")
(assert_trap (invoke "fill" (i64.const 0) (i64.const 4294967296)) "out of bounds table access")
(assert_trap (invoke "copy" (i64.const 4294967296) (i64.const 0) (i64.const 0)) "out of bounds table access")
(assert_trap (invoke "copy" (i64.const 0) (i64.const 4294967296) (i64.const 0)) "out of bounds table access")
(assert_trap (invoke "copy" (i64.const 0) (i64.const 0) (i64.const 4294967296)) "out of bounds table access")
(assert_return (invoke "get" (i64.const 0)) (i32.const 1))

(module
  (type $t (func (result i32)))
  (table i64 1 funcref)
  (func $target (type $t) i32.const 42)
  (elem (i64.const 0) func $target)
  (func (export "call") (param i64) (result i32)
    local.get 0 call_indirect (type $t))
  (func (export "tail") (param i64) (result i32)
    local.get 0 return_call_indirect (type $t)))
(assert_return (invoke "call" (i64.const 0)) (i32.const 42))
(assert_return (invoke "tail" (i64.const 0)) (i32.const 42))
(assert_trap (invoke "call" (i64.const 4294967296)) "undefined element")
(assert_trap (invoke "tail" (i64.const 4294967296)) "undefined element")
