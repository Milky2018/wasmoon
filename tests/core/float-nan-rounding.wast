;; Regression: arithmetic quiets signaling NaNs, while bitwise operations preserve payloads.
(module
  (func (export "f32.ceil") (param f32) (result f32) (f32.ceil (local.get 0)))
  (func (export "f32.floor") (param f32) (result f32) (f32.floor (local.get 0)))
  (func (export "f32.trunc") (param f32) (result f32) (f32.trunc (local.get 0)))
  (func (export "f32.nearest") (param f32) (result f32) (f32.nearest (local.get 0)))
  (func (export "f32.abs") (param f32) (result f32) (f32.abs (local.get 0)))
  (func (export "f32.neg") (param f32) (result f32) (f32.neg (local.get 0)))
  (func (export "f32x4.ceil") (param v128) (result v128) (f32x4.ceil (local.get 0)))
  (func (export "f32x4.floor") (param v128) (result v128) (f32x4.floor (local.get 0)))
  (func (export "f32x4.trunc") (param v128) (result v128) (f32x4.trunc (local.get 0)))
  (func (export "f32x4.nearest") (param v128) (result v128) (f32x4.nearest (local.get 0)))
  (func (export "f32x4.min") (param v128) (result v128) (f32x4.min (local.get 0) (local.get 0)))
  (func (export "f32x4.max") (param v128) (result v128) (f32x4.max (local.get 0) (local.get 0)))
  (func (export "f64.ceil") (param f64) (result f64) (f64.ceil (local.get 0)))
  (func (export "f64.floor") (param f64) (result f64) (f64.floor (local.get 0)))
  (func (export "f64.trunc") (param f64) (result f64) (f64.trunc (local.get 0)))
  (func (export "f64.nearest") (param f64) (result f64) (f64.nearest (local.get 0)))
  (func (export "f64.abs") (param f64) (result f64) (f64.abs (local.get 0)))
  (func (export "f64.neg") (param f64) (result f64) (f64.neg (local.get 0)))
  (func (export "f64x2.ceil") (param v128) (result v128) (f64x2.ceil (local.get 0)))
  (func (export "f64x2.floor") (param v128) (result v128) (f64x2.floor (local.get 0)))
  (func (export "f64x2.trunc") (param v128) (result v128) (f64x2.trunc (local.get 0)))
  (func (export "f64x2.nearest") (param v128) (result v128) (f64x2.nearest (local.get 0)))
  (func (export "f64x2.min") (param v128) (result v128) (f64x2.min (local.get 0) (local.get 0)))
  (func (export "f64x2.max") (param v128) (result v128) (f64x2.max (local.get 0) (local.get 0)))
)
(assert_return (invoke "f32.ceil" (f32.const nan:0x1)) (f32.const nan:arithmetic))
(assert_return (invoke "f32.ceil" (f32.const -0)) (f32.const -0))
(assert_return (invoke "f32x4.ceil" (v128.const f32x4 nan:0x1 nan:0x1 nan:0x1 nan:0x1)) (v128.const f32x4 nan:arithmetic nan:arithmetic nan:arithmetic nan:arithmetic))
(assert_return (invoke "f32.floor" (f32.const nan:0x1)) (f32.const nan:arithmetic))
(assert_return (invoke "f32.floor" (f32.const -0)) (f32.const -0))
(assert_return (invoke "f32x4.floor" (v128.const f32x4 nan:0x1 nan:0x1 nan:0x1 nan:0x1)) (v128.const f32x4 nan:arithmetic nan:arithmetic nan:arithmetic nan:arithmetic))
(assert_return (invoke "f32.trunc" (f32.const nan:0x1)) (f32.const nan:arithmetic))
(assert_return (invoke "f32.trunc" (f32.const -0)) (f32.const -0))
(assert_return (invoke "f32x4.trunc" (v128.const f32x4 nan:0x1 nan:0x1 nan:0x1 nan:0x1)) (v128.const f32x4 nan:arithmetic nan:arithmetic nan:arithmetic nan:arithmetic))
(assert_return (invoke "f32.nearest" (f32.const nan:0x1)) (f32.const nan:arithmetic))
(assert_return (invoke "f32.nearest" (f32.const -0)) (f32.const -0))
(assert_return (invoke "f32x4.nearest" (v128.const f32x4 nan:0x1 nan:0x1 nan:0x1 nan:0x1)) (v128.const f32x4 nan:arithmetic nan:arithmetic nan:arithmetic nan:arithmetic))
(assert_return (invoke "f32x4.min" (v128.const f32x4 nan nan nan nan)) (v128.const f32x4 nan:canonical nan:canonical nan:canonical nan:canonical))
(assert_return (invoke "f32x4.max" (v128.const f32x4 nan nan nan nan)) (v128.const f32x4 nan:canonical nan:canonical nan:canonical nan:canonical))
(assert_return (invoke "f32.abs" (f32.const -nan:0x1)) (f32.const nan:0x1))
(assert_return (invoke "f32.neg" (f32.const nan:0x1)) (f32.const -nan:0x1))
(assert_return (invoke "f32.nearest" (f32.const inf)) (f32.const inf))
(assert_return (invoke "f32.nearest" (f32.const -inf)) (f32.const -inf))
(assert_return (invoke "f32.nearest" (f32.const 0x1p100)) (f32.const 0x1p100))
(assert_return (invoke "f32.nearest" (f32.const -0.5)) (f32.const -0))
(assert_return (invoke "f64.ceil" (f64.const nan:0x1)) (f64.const nan:arithmetic))
(assert_return (invoke "f64.ceil" (f64.const -0)) (f64.const -0))
(assert_return (invoke "f64x2.ceil" (v128.const f64x2 nan:0x1 nan:0x1)) (v128.const f64x2 nan:arithmetic nan:arithmetic))
(assert_return (invoke "f64.floor" (f64.const nan:0x1)) (f64.const nan:arithmetic))
(assert_return (invoke "f64.floor" (f64.const -0)) (f64.const -0))
(assert_return (invoke "f64x2.floor" (v128.const f64x2 nan:0x1 nan:0x1)) (v128.const f64x2 nan:arithmetic nan:arithmetic))
(assert_return (invoke "f64.trunc" (f64.const nan:0x1)) (f64.const nan:arithmetic))
(assert_return (invoke "f64.trunc" (f64.const -0)) (f64.const -0))
(assert_return (invoke "f64x2.trunc" (v128.const f64x2 nan:0x1 nan:0x1)) (v128.const f64x2 nan:arithmetic nan:arithmetic))
(assert_return (invoke "f64.nearest" (f64.const nan:0x1)) (f64.const nan:arithmetic))
(assert_return (invoke "f64.nearest" (f64.const -0)) (f64.const -0))
(assert_return (invoke "f64x2.nearest" (v128.const f64x2 nan:0x1 nan:0x1)) (v128.const f64x2 nan:arithmetic nan:arithmetic))
(assert_return (invoke "f64x2.min" (v128.const f64x2 nan nan)) (v128.const f64x2 nan:canonical nan:canonical))
(assert_return (invoke "f64x2.max" (v128.const f64x2 nan nan)) (v128.const f64x2 nan:canonical nan:canonical))
(assert_return (invoke "f64.abs" (f64.const -nan:0x1)) (f64.const nan:0x1))
(assert_return (invoke "f64.neg" (f64.const nan:0x1)) (f64.const -nan:0x1))
(assert_return (invoke "f64.nearest" (f64.const inf)) (f64.const inf))
(assert_return (invoke "f64.nearest" (f64.const -inf)) (f64.const -inf))
(assert_return (invoke "f64.nearest" (f64.const 0x1p100)) (f64.const 0x1p100))
(assert_return (invoke "f64.nearest" (f64.const -0.5)) (f64.const -0))
