} derive(Eq, @debug.Debug)
pub fn TerminatorMetadata::empty() -> Self
pub fn TerminatorMetadata::equal(Self, Self) -> Bool
pub fn TerminatorMetadata::new(SourceLocation?, Array[Value]) -> Self
pub fn TerminatorMetadata::not_equal(Self, Self) -> Bool
pub fn TerminatorMetadata::to_repr(Self) -> @debug.Repr

pub struct TerminatorRecord {
  kind : Terminator
