// GNU ld scans package archives once, in dependency order. These C objects
// call one another across the MoonBit API packages and share one allocator.
options(
  "native-stub": [
    "dwarf/dwarf.c",
    "exec_memory/exec_mem.c",
    "ffi/abi/msvc_guest_bridges.S",
    "ffi/abi/stack_switch_aarch64.S",
    "ffi/abi/stack_switch_x86_64.S",
    "ffi/abi/trampoline_call_x86_64.S",
    "ffi/abi/windows_context_x86_64.S",
    "ffi/code/trampoline.c",
    "ffi/context/host_exit.c",
    "ffi/context/jit_context.c",
    "ffi/context/managed_context.c",
    "ffi/control/exception.c",
    "ffi/control/fiber.c",
    "ffi/control/guest_continuation.c",
    "ffi/control/hostcall.c",
    "ffi/control/trap.c",
    "ffi/gc/gc_allocator.c",
    "ffi/gc/gc_entries.c",
    "ffi/gc/gc_generation.c",
    "ffi/gc/gc_heap.c",
    "ffi/gc/gc_layout.c",
    "ffi/gc/gc_ops.c",
    "ffi/gc/gc_type_cache.c",
    "ffi/memory/atomic.c",
    "ffi/memory/atomic_wait.c",
    "ffi/memory/managed_memory.c",
    "ffi/memory/managed_table.c",
    "ffi/memory/memory_ops.c",
    "ffi/memory/segment_ops.c",
    "ffi/testing/atomic_test_support.c",
    "ffi/testing/context_test_support.c",
    "ffi/testing/continuation_test_support.c",
    "ffi/testing/failure_test_support.c",
    "ffi/testing/fiber_register_probe_aarch64.S",
    "ffi/testing/fiber_register_probe_x86_64.S",
    "ffi/testing/fiber_test_support.c",
    "ffi/testing/test_guest_bridges.S",
    "ffi/testing/trap_test_support.c",
    "ownership/cleanup.c",
    "ownership/native_alloc.c",
    "ownership/quota.c",
  ],
  targets: {
    "cleanup.mbt": [ "native" ],
    "quota.mbt": [ "native" ],
    "ownership_wasm.mbt": [ "wasm" ],
  },
)
