///|
test "core module type import identities retain punctuation and UTF-8" {
  validate_component(
    @component.parse_component(
      Bytes::from_array([
        0x00, 0x61, 0x73, 0x6d, 0x0d, 0x00, 0x01, 0x00, 0x03, 0x19, 0x01, 0x50, 0x03,
        0x01, 0x60, 0x00, 0x00, 0x00, 0x03, 0x61, 0x3a, 0x62, 0x01, 0x63, 0x00, 0x00,
        0x00, 0x01, 0x61, 0x03, 0x62, 0x3a, 0x63, 0x00, 0x00,
      ]),
    ),
  )
  validate_component(
    @component.parse_component(
      Bytes::from_array([
        0x00, 0x61, 0x73, 0x6d, 0x0d, 0x00, 0x01, 0x00, 0x03, 0x1d, 0x01, 0x50, 0x03,
        0x01, 0x60, 0x00, 0x00, 0x00, 0x03, 0xe7, 0x94, 0xb2, 0x03, 0x6f, 0x6e, 0x65,
        0x00, 0x00, 0x00, 0x03, 0xe4, 0xb9, 0x99, 0x03, 0x6f, 0x6e, 0x65, 0x00, 0x00,
      ]),
    ),
  )
}

///|
test "core module type names reject malformed UTF-8" {
  let rejected = try {
    validate_component(
      @component.parse_component(
        Bytes::from_array([
          0x00, 0x61, 0x73, 0x6d, 0x0d, 0x00, 0x01, 0x00, 0x03, 0x0e, 0x01, 0x50,
          0x02, 0x01, 0x60, 0x00, 0x00, 0x00, 0x01, 0xff, 0x01, 0x79, 0x00, 0x00,
        ]),
      ),
    )
    false
  } catch {
    SectionParseError(3, _) => true
    _ => false
  }
  assert_true(rejected)
}
