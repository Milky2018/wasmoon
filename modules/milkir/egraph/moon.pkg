import {
  "moonbitlang/core/debug",
  "moonbitlang/core/hashset",
  "moonbitlang/core/int",
}

rule(
  name: "generate_rule_matcher",
  command: "python3 egraph/tools/generate_rule_matcher.py $input $output",
)

dev_build(
  rule: "generate_rule_matcher",
  input: "rules_matcher.schema",
  output: "rules_match_generated.mbt",
)
