///|
fn generated_rule_bucket_size(tag : EOpcodeTag) -> Int {
  match tag {
    TAdd => 26
    TSub => 23
    TMul => 18
    TAnd => 20
    TOr => 16
    TXor => 17
    TBnot => 7
    TShl => 10
    TSshr => 8
    TUshr => 11
    TRotl => 8
    TRotr => 8
    TNeg => 4
    TSdiv => 1
    TUdiv => 1
    TSrem => 1
    TUrem => 1
    TIcmp => 51
    TEq => 16
    TNe => 16
    TClz => 1
    TCtz => 1
    TPopcnt => 2
    TBswap => 1
    TBitrev => 1
    TSelect => 18
    TFadd => 1
    TFsub => 1
    TFmul => 1
    TFdiv => 1
    TFmin => 1
    TFmax => 1
    TFcopysign => 1
    TFneg => 3
    TFabs => 3
    TFsqrt => 1
    TFceil => 1
    TFfloor => 1
    TFtrunc => 1
    TFnearest => 1
    TSplat => 1
    TIabs => 1
    TSmin => 1
    TUmin => 1
    TSmax => 1
    TUmax => 1
    TUextend => 3
    TSextend => 5
    TIreduce => 18
    _ => 0
  }
}

///|
fn generated_child_opcode_bits(
  eg : EGraph,
  class_id : EClassId,
) -> UInt64 {
  let mut bits = 0UL
  for node in eg.get_nodes(class_id) {
    match node.op.tag() {
      TAdd => bits = bits | 0x0000000000000001UL
      TAnd => bits = bits | 0x0000000000000002UL
      TBnot => bits = bits | 0x0000000000000004UL
      TEq => bits = bits | 0x0000000000000008UL
      TFabs => bits = bits | 0x0000000000000010UL
      TFneg => bits = bits | 0x0000000000000020UL
      TIcmp => bits = bits | 0x0000000000000040UL
      TIreduce => bits = bits | 0x0000000000000080UL
      TMul => bits = bits | 0x0000000000000100UL
      TNe => bits = bits | 0x0000000000000200UL
      TNeg => bits = bits | 0x0000000000000400UL
      TOr => bits = bits | 0x0000000000000800UL
      TRotl => bits = bits | 0x0000000000001000UL
      TRotr => bits = bits | 0x0000000000002000UL
      TSelect => bits = bits | 0x0000000000004000UL
      TSextend => bits = bits | 0x0000000000008000UL
      TShl => bits = bits | 0x0000000000010000UL
      TSmin => bits = bits | 0x0000000000020000UL
      TSpaceshipS => bits = bits | 0x0000000000040000UL
      TSpaceshipU => bits = bits | 0x0000000000080000UL
      TSplat => bits = bits | 0x0000000000100000UL
      TSshr => bits = bits | 0x0000000000200000UL
      TSub => bits = bits | 0x0000000000400000UL
      TUextend => bits = bits | 0x0000000000800000UL
      TUmin => bits = bits | 0x0000000001000000UL
      TUshr => bits = bits | 0x0000000002000000UL
      TXor => bits = bits | 0x0000000004000000UL
      _ => ()
    }
  }
  bits
}

