///|
fn generated_rule_bucket_size(tag : EOpcodeTag) -> Int {
  match tag {
    TAdd => 25
    TSub => 22
    TMul => 17
    TAnd => 19
    TOr => 15
    TXor => 16
    TBnot => 6
    TShl => 9
    TSshr => 7
    TUshr => 10
    TRotl => 7
    TRotr => 7
    TNeg => 3
    TSelect => 18
    TFadd => 1
    TFsub => 1
    TFmul => 1
    TFdiv => 1
    TFmin => 1
    TFmax => 1
    TFcopysign => 1
    TFneg => 3
    TFabs => 3
    TFsqrt => 1
    TFceil => 1
    TFfloor => 1
    TFtrunc => 1
    TFnearest => 1
    TSplat => 1
    TIabs => 1
    TPopcnt => 1
    TSmin => 1
    TUmin => 1
    TSmax => 1
    TUmax => 1
    TUextend => 3
    TSextend => 5
    TIreduce => 18
    TEq => 15
    TNe => 15
    TIcmp => 50
    _ => 0
  }
}

///|
fn generated_child_has_opcode(
  eg : EGraph,
  class_id : EClassId,
  tag : EOpcodeTag,
) -> Bool {
  for node in eg.get_nodes(class_id) {
    if node.op.tag() == tag {
      return true
    }
  }
  false
}

///|
fn generated_rule_match_bits(
  eg : EGraph,
  class_id : EClassId,
  tag : EOpcodeTag,
) -> UInt64 {
  match tag {
    TAdd => {
      let mut bits = 0x0000000000000000UL
      for node in eg.get_nodes(class_id) {
        if node.op.tag() != TAdd {
          continue
        }
        match node.children.length() {
          2 => {
            if eg.find_const(node.children[0]) is Some(0L) {
              bits = bits | 0x0000000000000001UL
            }
            if eg.find_const(node.children[1]) is Some(0L) {
              bits = bits | 0x0000000000000001UL
            }
            if generated_child_has_opcode(eg, node.children[0], TAnd) && generated_child_has_opcode(eg, node.children[1], TXor) {
              bits = bits | 0x0000000000000002UL
            }
            if generated_child_has_opcode(eg, node.children[0], TXor) && generated_child_has_opcode(eg, node.children[1], TAnd) {
              bits = bits | 0x0000000000000002UL
            }
            if generated_child_has_opcode(eg, node.children[0], TOr) && generated_child_has_opcode(eg, node.children[1], TAnd) {
              bits = bits | 0x0000000000000004UL
            }
            if generated_child_has_opcode(eg, node.children[0], TAnd) && generated_child_has_opcode(eg, node.children[1], TOr) {
              bits = bits | 0x0000000000000004UL
            }
            if generated_child_has_opcode(eg, node.children[0], TShl) && generated_child_has_opcode(eg, node.children[1], TShl) {
              bits = bits | 0x0000000000000008UL
            }
            if eg.equiv(node.children[0], node.children[1]) {
              bits = bits | 0x0000000000000010UL
            }
            if generated_child_has_opcode(eg, node.children[1], TNeg) {
              bits = bits | 0x0000000000000020UL
            }
            if generated_child_has_opcode(eg, node.children[1], TSub) {
              bits = bits | 0x00000000000C0120UL
            }
