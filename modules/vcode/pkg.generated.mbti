#derive(Eq, @debug.Debug)
pub(all) enum VectorConversion {
  ExtendLow(@native_lowering.VectorLane, @native_types.Signedness)
  ExtendHigh(@native_lowering.VectorLane, @native_types.Signedness)
  Narrow(@native_lowering.VectorLane, @native_types.Signedness)
  FloatToInt(@native_lowering.VectorLane, @native_types.Signedness)
  IntToFloat(@native_lowering.VectorLane, @native_types.Signedness)
  PromoteLowF32x4
  DemoteZeroF64x2
}
