///|
/// Component Model syntax exposed alongside Wasmoon's runtime interface.
///
/// Concrete types and parsing behavior are owned by the portable
/// `Milky2018/wasm_component` package.

///|
pub using @model {
  type BinaryKind,
  type Section,
  type ComponentBinary,
  type ComponentParseError,
  type StringEncoding,
  type CanonOpt,
  type Canon,
  type Start,
  type Component,
  type CoreInstantiateArg,
  type CoreInlineExport,
  type CoreInstanceExpr,
  type CoreInstanceDecl,
  type Sort,
  type SortIdx,
  type TypeBound,
  type ValueBound,
  type ExternDesc,
  type ImportName,
  type ExportName,
  type NameAttribute,
  type Import,
  type Export,
  type InstantiateArg,
  type InlineExport,
  type InstanceExpr,
  type Instance,
  type AliasTarget,
  type Alias,
  type PrimValType,
  type ValType,
  type ResourceKind,
  type Param,
  type FuncType,
  type InstanceDecl,
  type ComponentDecl,
  type TypeDef,
  type RecordField,
  type VariantCase,
  sniff_binary_kind,
  parse_component_binary,
  parse_canon_section,
  parse_start_section,
  parse_component,
  parse_core_instance_section,
  parse_import_section,
  parse_export_section,
  parse_instance_section,
  parse_alias_section,
  parse_type_section,
}
