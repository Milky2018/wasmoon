// Shared runtime and execution lifecycle blackbox fixtures.
// Ordinary native tests run these here. scripts/run_sanitizers.py copies the
// same files into one isolated package with declarative ASan/UBSan link flags;
// the instrumentation configuration lives in tools/sanitizer/moon.pkg.
import {
  "Milky2018/wasm_component" @component_types,
  "Milky2018/wasm_core/types",
  "Milky2018/wasmoon/cmd/wasmoon/commands",
  "Milky2018/wasmoon/component",
  "Milky2018/wasm_component/text" @component_text,
  "Milky2018/wasmoon/executor",
  "Milky2018/wasmoon/jit",
  "Milky2018/wasmoon/runtime",
  "Milky2018/wasmoon/wasi_component",
  "Milky2018/wasmoon/wast",
  "Milky2018/wasm_core/wat",
  "Milky2018/wasm_component/wit",
  "Milky2018/wasmoon/wit_binding",
  "Milky2018/wasmoon_jit",
  "moonbitlang/async",
  "moonbitlang/x/fs",
} for "test"
