    "wasi:http@0.3.0/handler" => [("request", 163), ("response", 164), ("error-code", 165)]
    "wasi:http@0.3.0/client" => [("request", 168), ("response", 169), ("error-code", 170)]
    _ => @wasi_component.wasi_preview3_exported_types(interface)
  }
}

