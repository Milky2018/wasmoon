///|
/// Release retained working-array buffers between serial allocation jobs.
/// Existing allocation plans remain valid. The session can be used again.
/// Do not call from an allocation observer while a job is running.
pub fn AllocationSession::release_scratch(self : AllocationSession) -> Unit {
  self.context_priorities.clear()
  self.context_priorities.shrink_to_fit()
  self.context_weights.clear()
  self.context_weights.shrink_to_fit()
  self.context_fixed_constraints.clear()
  self.context_fixed_constraints.shrink_to_fit()
  self.context_boundary_costs.clear()
  self.context_boundary_costs.shrink_to_fit()
  self.context_minimals.clear()
  self.context_minimals.shrink_to_fit()
  self.context_spill_sets.clear()
  self.context_spill_sets.shrink_to_fit()
  self.segment_owner.clear()
  self.segment_owner.shrink_to_fit()
  self.segment_spill_set.clear()
  self.segment_spill_set.shrink_to_fit()
  self.owner_run_count.clear()
  self.owner_run_count.shrink_to_fit()
  self.occupied_block_order.clear()
  self.occupied_block_order.shrink_to_fit()
  self.occupied_roots.clear()
  self.occupied_roots.shrink_to_fit()
  self.occupied_left.clear()
  self.occupied_left.shrink_to_fit()
  self.occupied_right.clear()
  self.occupied_right.shrink_to_fit()
  self.occupied_parent.clear()
  self.occupied_parent.shrink_to_fit()
  self.occupied_previous.clear()
  self.occupied_previous.shrink_to_fit()
  self.occupied_next.clear()
  self.occupied_next.shrink_to_fit()
  self.occupied_starts.clear()
  self.occupied_starts.shrink_to_fit()
  self.occupied_ends.clear()
  self.occupied_ends.shrink_to_fit()
  self.occupied_stack.clear()
  self.occupied_stack.shrink_to_fit()
  self.preferred_by_value.clear()
  self.preferred_by_value.shrink_to_fit()
  self.conflict_marks.clear()
  self.conflict_marks.shrink_to_fit()
  self.probe_conflicts.clear()
  self.probe_conflicts.shrink_to_fit()
  self.eviction_conflicts.clear()
  self.eviction_conflicts.shrink_to_fit()
  self.register_order.clear()
  self.register_order.shrink_to_fit()
  self.register_order_marks.clear()
  self.register_order_marks.shrink_to_fit()
  self.physical_register_indexes.clear()
  self.physical_register_indexes.shrink_to_fit()
  self.queue_items.clear()
  self.queue_items.shrink_to_fit()
  self.queue_priorities.clear()
  self.queue_priorities.shrink_to_fit()
  self.queue_weights.clear()
  self.queue_weights.shrink_to_fit()
  self.queue_in_queue.clear()
  self.queue_in_queue.shrink_to_fit()
  self.queue_hints.clear()
  self.queue_hints.shrink_to_fit()
}
