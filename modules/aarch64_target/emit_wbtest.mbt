      #|  0x67,
      #|  0xb8,
      #|  0x60,
      #|  0x4e,
      #|  0x67,
      #|  0xb8,
      #|  0x60,
      #|  0x6e,
      #|  0x67,
      #|  0x84,
      #|  0x65,
      #|  0x4e,
      #|  0x67,
      #|  0x84,
      #|  0x65,
      #|  0x6e,
