      #|    { offset: 4, operation: SetFramePointer(Int, 5, cfa_offset=16) },
      #|    { offset: 11, operation: StackAlloc(size=48) },
      #|    { offset: 19, operation: SaveRegister(Int, 3, cfa_offset=-48) },
