///|
test "x64 target preserves an incoming result area across indirect calls" {
  let result_types : Array[@semantic_machv.ValueType] = [
    I32,
    I32,
    I32,
    I32,
    I32,
    I32,
    I32,
    I32,
    I32,
  ]
  let builder = @semantic_machv.FunctionBuilder::new(
    "x64_indirect_overflow_results",
    Internal,
    [Ptr64, Ptr64],
    result_types,
  )
  let parameters = builder.parameters()
  let call = @semantic_machv.SemanticCall::new(
    Indirect,
    @semantic_machv.Signature::new([Ptr64], result_types),
    Internal,
    @semantic_machv.CallBehavior::new(ReadWrite, true, true, false, false),
  )
  let results = builder.emit(
    Call(call),
    [parameters[1], parameters[0]],
    result_types,
  )
  builder.return_(results)
  debug_inspect(
    build_x64_target(builder.finish()).object,
    content=(
      #|{
      #|  architecture: X64,
      #|  code: [
      #|    0x55,
      #|    0x48,
      #|    0x89,
      #|    0xe5,
      #|    0x48,
      #|    0x81,
      #|    0xec,
      #|    0x30,
      #|    0x00,
      #|    0x00,
      #|    0x00,
      #|    0x48,
      #|    0x89,
      #|    0x9c,
      #|    0x24,
      #|    0x10,
      #|    0x00,
      #|    0x00,
      #|    0x00,
      #|    0x4c,
      #|    0x89,
      #|    0xa4,
      #|    0x24,
      #|    0x18,
      #|    0x00,
